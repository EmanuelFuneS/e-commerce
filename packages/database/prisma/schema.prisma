generator client {
  provider      = "prisma-client-js"
  // output        = "../src/generated/prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== ENUMS =====
enum StockMovementType {
  IN
  OUT
  ADJUST

  @@map("stock_movement_type")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum CouponType {
  PERCENTAGE
  FIXED
  SHIPPING

  @@map("coupon_type")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("discount_type")
}

enum PaymentType {
  CARD
  PAYPAL
  MERCADO_PAGO
  CRYPTO
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MERCADOPAGO
}

enum CardBrand {
  VISA
  MASTERCARD
  AMEX
  DISCOVER
  DINERS
  MAESTRO
  OTHER
}

// ============================================
// AUTH MODELS (del auth-service)
// ============================================

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String
  name                 String?
  photo                String?
  tenantId             String    @default("BYTE_BAZAR") @map("tenant_id")
  isActive             Boolean   @default(true) @map("is_active")
  isVerified           Boolean   @default(false) @map("is_verified")
  verificationToken    String?   @map("verification_token")
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  lastLogin            DateTime? @map("last_login")
  loginAttempts        Int       @default(0) @map("login_attempts")
  lockedUntil          DateTime? @map("locked_until")

  //customer ids 
  stripeCustomerId      String? @unique @map("stripe_customer_id")
  mercadopagoCustomerId String? @unique @map("mercadopago_customer_id")
  paypalCustomerId      String? @unique @map("paypal_customer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  //Relaciones Payment
  shippingAddress ShippingAddress[]
  paymentMethods  PaymentMethod[]

  // Relaciones auth
  userRoles     UserRole[]
  refreshTokens RefreshToken[]

  // Relaciones con otros dominios (si las necesitas)
  orders         Order[]
  stockMovements StockMovement[]
  couponUsages   CouponUsage[]
  // Agrega más según necesites

  @@index([email])
  @@map("users")
}

model ShippingAddress {
  id     String @id @default(cuid())
  userId String @map("user_id")

  //Información Destinatario
  recipientName String @map("recipient_name")
  phoneNumber   String @map("phone_number")

  //Dirección
  addressLine1  String  @map("address_line1")
  addressLine2  String? @map("address_line2")
  city          String
  stateProvince String? @map("state_province")
  postalCode    String  @map("postal_code")
  countryCode   String  @map("country_code")

  //metadata
  isDefault Boolean @default(false) @map("is_default")
  label     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethodsBilling PaymentMethod[] @relation("BillingAddress")

  @@index([userId])
  @@index([userId, isDefault])
  @@map("shipping_addresses")
}

model PaymentMethod {
  id     String @id @default(cuid())
  userId String @map("user_id")

  //Tipo Proveedor
  paymentType PaymentType     @map("Payment_type")
  provider    PaymentProvider

  //Stripe
  stripePaymentMethodId String? @map("stripe_payment_method_id")

  //MP
  mercadopagoCardId  String? @map("mercadopago_card_id")
  mercadopagoPayerId String? @map("mercadopago_payer_id")

  //PAYPAL
  paypalBillingToken String? @map("paypal_billing_token")
  paypalPayerId      String? @map("paypal_payer_id")
  paypalEmail        String? @map("paypal_email")

  //metadata card
  cardLast4      String? @map("card_last4")
  cardBrand      String? @map("card_brand")
  cardExpMonth   Int?    @map("card_exp_month")
  cardExpYear    Int?    @map("card_ext_year")
  cardholderName String? @map("cardholder_name")

  //Billing Address
  billingAddressId String?          @map("billing_address_id")
  billingAddress   ShippingAddress? @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)

  //metadata
  isDefault  Boolean @default(false) @map("is_default")
  isVerified Boolean @default(false) @map("is_verified")
  nickname   String? @db.VarChar(100)

  //Verificación del method 
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  User User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isDefault, isActive])
  @@index([provider])
  @@map("payment_methods")
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles          UserRole[]
  roleHasPermissions RoleHasPermission[]

  @@map("roles")
}

model RolePermission {
  id           String @id @default(cuid())
  action       String // create, read, update, delete
  subject      String // user, products, orders, etc
  permissionId Int    @unique @default(autoincrement()) @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleHasPermissions RoleHasPermission[]

  @@unique([action, subject])
  @@map("role_permissions")
}

model RoleHasPermission {
  id               String @id @default(cuid())
  roleId           String @map("role_id")
  rolePermissionId String @map("role_permission_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role           Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  rolePermission RolePermission @relation(fields: [rolePermissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, rolePermissionId])
  @@map("role_has_permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  tenantId  String   @default("BYTE_BAZAR") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================
// BUSINESS MODELS (main-app, order-service, etc)
// ============================================

model Category {
  id        String    @id @default(cuid())
  name      String
  imageUrl  String?   @map("image_url")
  tenantId  String    @default("BYTE_BAZAR") @map("tenant_id")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  logo      String?
  tenantId  String    @default("BYTE_BAZAR") @map("tenant_id")
  website   String?
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

model Product {
  id             String          @id @default(cuid())
  name           String
  description    String          @db.Text
  tenantId       String          @default("BYTE_BAZAR") @map("tenant_id")
  spec           Json?
  sku            String          @unique
  price          Decimal         @db.Decimal(10, 2)
  stock          Int             @default(0)
  categoryId     String          @map("category_id")
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId        String          @map("brand_id")
  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  images         String[]
  tags           String[]        @default([])
  isActive       Boolean         @default(true) @map("is_active")
  slug           String          @unique
  views          Int             @default(0)
  discounts      Discount[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@index([isActive])
  @@map("products")
}

// ===== DESCUENTOS =====
model Discount {
  id            String       @id @default(cuid())
  productId     String       @map("product_id")
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(5, 2)
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  isActive      Boolean      @default(true) @map("is_active")
  reason        String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([productId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@map("discounts")
}

// ===== GESTIÓN DE STOCK =====
model StockMovement {
  id        String            @id @default(cuid())
  productId String            @map("product_id")
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int
  reason    String?
  reference String?
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id])
  tenantId  String            @default("BYTE_BAZAR") @map("tenant_id")
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ===== ÓRDENES Y VENTAS =====
model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique @map("order_number")
  tenantId        String        @default("BYTE_BAZAR") @map("tenant_id")
  userId          String?       @map("user_id")
  user            User?         @relation(fields: [userId], references: [id])
  customerName    String        @map("customer_name")
  customerEmail   String        @map("customer_email")
  customerPhone   String        @map("customer_phone")
  shippingAddress Json          @map("shipping_address")
  billingAddress  Json?         @map("billing_address")
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingCost    Decimal       @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  paymentMethod   String        @map("payment_method")
  paymentId       String?       @map("payment_id")
  items           OrderItem[]
  couponUsages    CouponUsage[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  shippedAt       DateTime?     @map("shipped_at")
  deliveredAt     DateTime?     @map("delivered_at")

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ===== CUPONES Y DESCUENTOS =====
model Coupon {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  description    String?       @db.Text
  type           CouponType
  value          Decimal       @db.Decimal(10, 2)
  minOrderAmount Decimal       @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscount    Decimal?      @map("max_discount") @db.Decimal(10, 2)
  usageLimit     Int?          @map("usage_limit")
  usageCount     Int           @default(0) @map("usage_count")
  userUsageLimit Int           @default(1) @map("user_usage_limit")
  isActive       Boolean       @default(true) @map("is_active")
  startDate      DateTime      @map("start_date")
  endDate        DateTime      @map("end_date")
  usages         CouponUsage[]
  tenantId       String        @default("BYTE_BAZAR") @map("tenant_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String   @map("coupon_id")
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id])
  orderId  String   @map("order_id")
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usedAt   DateTime @default(now()) @map("used_at")

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}
