{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "db.migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NODE_ENV",
        "PRISMA_LOGS",
        "APP_BASE_URL",
        "REDIS_URL",

        "API_PORT",
        "SMTP_HOST",
        "SMTP_PORT",
        "USERNAME",
        "PASSWORD",
        "MAILTRAP",

        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "CLOUDINARY_API_ENV",

        "DATABASE_URL",
        "DIRECT_URL",

        "TENANT_ID_APP",
        "BYTE_BAZAR_URL",
        "AUTH_SERVICE_URL",
        "AUTH_APP_URL",
        "AUTHORIZED_ROLES"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docker:up": {
      "cache": false,
      "persistent": true
    },
    "docker:down": {
      "cache": false,
      "persistent": true
    },
    "docker:rebuild": {
      "cache": false,
      "persistent": true
    }
  }
}
