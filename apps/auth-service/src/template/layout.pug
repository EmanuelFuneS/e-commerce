doctype html
html(lang="es")
  head
    style.
      :root {
        --background: #eff1f5; /* oklch(0.93 0.009 247) */
        --primary: #343434;    /* oklch(0.205 0 0) */
        --card: #ffffff;
      }
      body { background-color: #eff1f5; font-family: sans-serif; margin: 0; padding: 20px; }
      .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0; }
      .header { background: #1a1a1a; padding: 30px; text-align: center; color: white; }
      .content { padding: 40px; color: #1a1a1a; line-height: 1.6; }
      .button { display: inline-block; padding: 12px 24px; background: #1a1a1a; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 20px; }
      .footer { padding: 20px; text-align: center; font-size: 12px; color: #64748b; }
  body
    .container
      block content
      .footer
