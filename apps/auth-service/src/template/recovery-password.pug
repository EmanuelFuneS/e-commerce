extends layout

block content
  .header
    h1 Reset Password
  .content
    p If you do not want to receive this email, you can ignore it safely.
    div(style="background: #f1f5f9; padding: 20px; text-align: center; font-size: 24px; letter-spacing: 5px; font-family: monospace; border-radius: 6px; margin: 20px 0;")
      strong #{token}
    p If you do not want to receive this email, you can ignore it safely.
    a.button(href=recoveryUrl) Reset Password
