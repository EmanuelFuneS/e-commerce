{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "docker:up": "turbo run docker:up --filter=auth-app --filter=auth-service",
    "docker:down": "turbo run docker:down --filter=auth-app --filter=auth-service",
    "docker:rebuild": "turbo run docker:rebuild --filter=auth-app --filter=auth-service",
    "docker:rebuild:auth-app": "cd apps/auth-app && docker compose up -d --build",
    "docker:rebuild:auth-service": "cd apps/auth-service && docker compose up -d --build"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.5.1",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  }
}
